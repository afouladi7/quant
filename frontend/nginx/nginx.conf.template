# Rendered at container start by entrypoint.sh (envsubst on ${MARKETLAB_BACKEND_URL}
# and ${NGINX_PORT}). Every writable path lives under /tmp so the root FS can be read-only.
worker_processes 1;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format json escape=json '{"ts":"$time_iso8601","logger":"nginx","method":"$request_method",'
                                '"uri":"$uri","status":$status,"bytes":$body_bytes_sent,'
                                '"duration_s":$request_time,"upstream_s":"$upstream_response_time"}';
    access_log /dev/stdout json;

    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path       /tmp/nginx/proxy;
    fastcgi_temp_path     /tmp/nginx/fastcgi;
    uwsgi_temp_path       /tmp/nginx/uwsgi;
    scgi_temp_path        /tmp/nginx/scgi;

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 64k;   # API payloads are small; TCP-lab bodies are bounded by the backend too

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream marketlab_backend {
        server ${MARKETLAB_BACKEND_HOSTPORT};
        keepalive 16;
    }

    server {
        listen ${NGINX_PORT};
        root /opt/app-root/src;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

        # nginx's own liveness (does not depend on the backend).
        location = /nginx-health { access_log off; return 200 "ok\n"; }

        location = /api/v1/stream {
            proxy_pass http://marketlab_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location /api/ {
            proxy_pass http://marketlab_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        location /healthz/ {
            proxy_pass http://marketlab_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # SPA fallback for client-side routes.
        location / {
            add_header Cache-Control "no-cache";
            try_files $uri /index.html;
        }
    }
}
